# Copy to .env and adjust. Every required variable is listed with a mock value.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=test
DB_NAME=postgres
DB_SCHEMA=express

# Required. No default. Number from 0 to 100.
PASS_PERCENTAGE=40
# Required. No default. YYYY-YY where the second year is the first + 1.
ACADEMIC_YEAR=2026-27

# Required. At least 16 characters.
JWT_SECRET=change-me-to-a-long-secret
ACCESS_TOKEN_TTL_SECONDS=900

# Comma-separated full origins. "*" is rejected at boot.
CORS_ORIGINS=http://localhost:3000

# Max POST /api/students/:id/marks per user per 10 minutes.
MARKS_RATE_LIMIT_MAX=60
